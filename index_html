<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>MRSTOUD TV - موقع الأفلام والمسلسلات</title>
    <style>
        :root {
            --bg-dark: #0a0a0a;
            --bg-card: #121212;
            --bg-input: #1a1a1a;
            --accent-red: #e50914;
            --accent-blue: #2563eb;
            --text-light: #ffffff;
            --text-dim: #9ca3af;
            --border: #222222;
            --danger: #ef4444;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-light);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* --- الهيدر العلوي (المظهر الجديد المماثل للصورة) --- */
        .app-header {
            width: 100%;
            max-width: 900px;
            background-color: #0d0d0d;
            padding: 12px 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 900;
            border-bottom: 1px solid var(--border);
        }

        /* زر القائمة جهة اليمين */
        .header-icon-btn {
            background: none;
            border: none;
            color: var(--accent-red);
            font-size: 1.6rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 4px;
        }

        /* اسم الموقع في المنتصف */
        .brand-title {
            font-size: 1.7rem;
            font-weight: 900;
            color: var(--accent-red);
            letter-spacing: 0.5px;
            cursor: pointer;
            text-transform: uppercase;
        }

        /* --- القائمة الجانبية --- */
        .sidebar-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.85);
            backdrop-filter: blur(5px);
            z-index: 998;
            display: none;
        }

        .sidebar {
            position: fixed;
            top: 0; right: -300px;
            width: 280px;
            height: 100%;
            background-color: var(--bg-card);
            border-left: 1px solid var(--border);
            z-index: 999;
            transition: 0.3s ease-in-out;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .sidebar.active { right: 0; }

        .sidebar-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border);
            padding-bottom: 10px;
            color: var(--accent-red);
            font-weight: bold;
        }

        .sidebar-item {
            background-color: var(--bg-input);
            border: 1px solid var(--border);
            color: white;
            padding: 12px;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
        }

        /* --- الحاوية الرئيسية --- */
        .app-container {
            width: 100%;
            max-width: 900px;
            display: flex;
            flex-direction: column;
            padding: 10px;
        }

        .page-view {
            display: none;
            flex-direction: column;
            gap: 15px;
        }

        .page-view.active {
            display: flex;
        }

        .btn-main {
            background-color: var(--accent-red);
            border: none;
            color: white;
            padding: 14px;
            border-radius: 8px;
            font-weight: bold;
            font-size: 1rem;
            cursor: pointer;
            text-align: center;
            transition: 0.2s;
        }

        .btn-main:hover {
            opacity: 0.9;
        }

        .btn-back {
            background: var(--bg-input);
            border: 1px solid var(--border);
            color: var(--accent-red);
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 0.85rem;
            font-weight: bold;
            cursor: pointer;
            width: fit-content;
        }

        .search-bar-box {
            display: none;
            padding: 10px 0;
        }

        .search-bar-input {
            width: 100%;
            padding: 12px 14px;
            border-radius: 8px;
            border: 1px solid var(--border);
            background-color: var(--bg-input);
            color: white;
            font-size: 0.9rem;
            outline: none;
        }

        textarea.search-bar-input {
            resize: vertical;
            min-height: 70px;
        }

        /* --- شبكة البطاقات --- */
        .media-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            margin-top: 5px;
        }

        @media (min-width: 600px) {
            .media-grid { grid-template-columns: repeat(3, 1fr); }
        }

        @media (min-width: 800px) {
            .media-grid { grid-template-columns: repeat(4, 1fr); }
        }

        .media-card {
            background: #000;
            border-radius: 6px;
            overflow: hidden;
            cursor: pointer;
            position: relative;
            aspect-ratio: 2 / 3;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
        }

        .media-poster-img {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            object-fit: cover;
        }

        .episode-badge {
            position: absolute;
            top: 0; right: 0;
            background-color: var(--accent-red);
            color: white;
            padding: 4px 8px;
            text-align: center;
            border-bottom-left-radius: 6px;
            z-index: 5;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-width: 45px;
        }

        .episode-badge .lbl { font-size: 0.65rem; font-weight: bold; }
        .episode-badge .num { font-size: 0.95rem; font-weight: 900; line-height: 1; }

        .media-card-overlay {
            position: relative;
            z-index: 4;
            background: linear-gradient(to top, rgba(0, 0, 0, 0.95) 0%, rgba(0, 0, 0, 0.6) 70%, transparent 100%);
            padding: 25px 8px 10px 8px;
            text-align: center;
        }

        .media-card-title {
            font-size: 0.85rem;
            font-weight: 700;
            color: #ffffff;
            text-shadow: 0 1px 3px rgba(0,0,0,0.8);
            line-height: 1.3;
        }

        /* --- صفحة تفاصيل المسلسل --- */
        .show-header-banner {
            position: relative;
            width: 100%;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid var(--border);
            background-size: cover;
            background-position: center;
            padding: 25px 15px 20px 15px;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            min-height: 220px;
        }

        .show-header-banner::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.95) 10%, rgba(0,0,0,0.65) 60%, rgba(0,0,0,0.4) 100%);
        }

        .show-header-content {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .show-title {
            font-size: 1.5rem;
            font-weight: 900;
            color: #ffffff;
        }

        .show-description {
            font-size: 0.85rem;
            color: #e5e7eb;
            line-height: 1.5;
            max-width: 750px;
        }

        .show-cast {
            font-size: 0.8rem;
            color: var(--text-dim);
            line-height: 1.4;
        }

        .show-cast span {
            color: #ffffff;
            font-weight: 600;
        }

        /* --- مشغل الفيديو --- */
        .player-container {
            position: relative;
            width: 100%;
            background: #000;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid var(--border);
            margin-top: 10px;
        }

        video {
            width: 100%;
            max-height: 480px;
            display: block;
        }

        .video-center-watermark {
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            color: #ffffff;
            font-size: 1.4rem;
            font-weight: 900;
            letter-spacing: 2px;
            text-transform: uppercase;
            pointer-events: none;
            z-index: 10;
            background: rgba(0, 0, 0, 0.45);
            padding: 6px 18px;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.3);
            text-shadow: 0 0 8px rgba(0, 0, 0, 0.9);
            opacity: 0.85;
        }

        /* --- لوحة الإدارة --- */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background-color: rgba(0, 0, 0, 0.92);
            backdrop-filter: blur(8px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            padding: 15px;
        }

        .modal-box {
            background-color: var(--bg-card);
            border: 1px solid var(--accent-red);
            border-radius: 18px;
            width: 100%;
            max-width: 550px;
            max-height: 85vh;
            overflow-y: auto;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .admin-video-item {
            background: var(--bg-input);
            border: 1px solid var(--border);
            padding: 10px;
            border-radius: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.85rem;
        }

        .btn-del-single {
            background: var(--danger);
            color: white;
            border: none;
            padding: 6px 10px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.75rem;
            font-weight: bold;
        }

        #fileInputAdminVideo { display: none; }
    </style>
</head>
<body>

    <!-- القائمة الجانبية -->
    <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <span>⚙️ القائمة</span>
            <span style="cursor:pointer; color:var(--danger);" onclick="closeSidebar()">✖</span>
        </div>
        <div class="sidebar-item" onclick="navigateTo('showsListPage'); closeSidebar();">📺 قائمة المسلسلات</div>
        <div class="sidebar-item" onclick="openAdminPanel(); closeSidebar();">🔒 لوحة الإدارة</div>
        <div class="sidebar-item" onclick="shareProject(); closeSidebar();">📤 مشاركة موقع MRSTOUD TV</div>
        <div style="margin-top:auto; font-size:0.75rem; color:var(--text-dim); text-align:center;">
            منصة MRSTOUD TV<br>المالك: <b>Mrstoud</b>
        </div>
    </div>

    <!-- الهيدر العلوي (التنسيق الجديد بالضبط) -->
    <div class="app-header">
        <!-- 1. زر القائمة الجانبية جهة اليمين فوق -->
        <button class="header-icon-btn" onclick="openSidebar()">☰</button>
        
        <!-- 2. اسم الموقع في منتصف الهيدر فوق -->
        <div class="brand-title" onclick="navigateTo('homePage')">MRSTOUD TV</div>
        
        <!-- 3. زر البحث جهة اليسار فوق -->
        <button class="header-icon-btn" onclick="toggleSearchBox()">🔍</button>
    </div>

    <!-- الحاوية الرئيسية -->
    <div class="app-container">

        <!-- شريط البحث -->
        <div class="search-bar-box" id="searchBoxContainer">
            <input type="text" class="search-bar-input" id="gallerySearch" placeholder="🔍 ابحث عن حلقة أو مسلسل..." onkeyup="filterContent()">
        </div>

        <!-- ===== 1. الصفحة الرئيسية (جميع الحلقات المتاحة) ===== -->
        <div class="page-view active" id="homePage">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 5px;">
                <span style="color: var(--text-dim); font-size:0.9rem; font-weight: bold;" id="homeCount">0 حلقة متاحة</span>
            </div>
            <div class="media-grid" id="homeGrid"></div>
        </div>

        <!-- ===== 2. صفحة قائمة المسلسلات ===== -->
        <div class="page-view" id="showsListPage">
            <button class="btn-back" onclick="navigateTo('homePage')">➔ الرجوع للرئيسية</button>
            <h3 style="color:var(--accent-red); font-size:1.1rem; margin-top:5px;">📺 قائمة كافة المسلسلات</h3>
            <div class="media-grid" id="showsGrid"></div>
        </div>

        <!-- ===== 3. صفحة تفاصيل المسلسل وحلقاته ===== -->
        <div class="page-view" id="showDetailPage">
            <button class="btn-back" onclick="navigateTo('showsListPage')">➔ رجوع لقائمة المسلسلات</button>
            
            <!-- بنر تفاصيل المسلسل والوصف -->
            <div class="show-header-banner" id="showBanner">
                <div class="show-header-content">
                    <div class="show-title" id="showBannerTitle"></div>
                    <div class="show-description" id="showBannerDesc"></div>
                    <div class="show-cast" id="showBannerCast"></div>
                </div>
            </div>

            <h4 style="color:var(--accent-red); font-size:1rem; margin-top:10px;">🎬 جميع حلقات المسلسل</h4>
            <div class="media-grid" id="showEpisodesGrid"></div>
        </div>

        <!-- ===== 4. صفحة مشغل الفيديو ===== -->
        <div class="page-view" id="playerPage">
            <button class="btn-back" onclick="goBackFromPlayer()">➔ رجوع</button>
            
            <h2 id="currentMediaTitle" style="color: var(--accent-red); font-size: 1.1rem; margin-top: 10px; font-weight: bold;"></h2>

            <div class="player-container">
                <video id="mainVideoPlayer" controls playsinline preload="metadata">
                    <source id="videoSource" src="">
                </video>
                <div class="video-center-watermark">Mrstoud</div>
            </div>
        </div>

    </div>

    <!-- ===== لوحة الإدارة ===== -->
    <div class="modal-overlay" id="adminModal">
        <div class="modal-box">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <h3 style="color: var(--accent-red);">🔒 لوحة إدارة MRSTOUD TV</h3>
                <span style="cursor:pointer; color:var(--danger);" onclick="closeAdminPanel()">✖</span>
            </div>

            <!-- نموذج إضافة/تعديل حلقة ومسلسل -->
            <div style="border-bottom: 1px solid var(--border); padding-bottom: 15px;">
                <h4 style="color: var(--accent-red); font-size:0.9rem; margin-bottom:10px;">🎬 إضافة حلقة مسلسل جديدة</h4>
                
                <div style="display:flex; flex-direction:column; gap:8px; margin-bottom:10px;">
                    <input type="text" id="adminShowName" placeholder="اسم المسلسل (مثال: مسلسل أخي)..." class="search-bar-input">
                    <input type="number" id="adminEpisodeNum" placeholder="رقم الحلقة (مثال: 22)..." class="search-bar-input">
                    <input type="text" id="adminUrl" placeholder="رابط الفيديو المباشر (أو ارفعه من زر الملفات بالأسفل)..." class="search-bar-input">
                    <input type="text" id="adminPosterUrl" placeholder="رابط صورة غلاف المسلسل (البوستر)..." class="search-bar-input">
                    <textarea id="adminShowDesc" placeholder="وصف المسلسل (قصة المسلسل)..." class="search-bar-input"></textarea>
                    <input type="text" id="adminShowCast" placeholder="أسماء الممثلين..." class="search-bar-input">
                </div>

                <input type="file" id="fileInputAdminVideo" accept="video/*">
                
                <div style="display:flex; gap:8px;">
                    <button class="btn-main" style="flex:1;" onclick="addVideoFromAdmin()">➕ حفظ وإضافة</button>
                    <button class="btn-main" style="background:var(--bg-input); border:1px solid var(--border); font-size:0.8rem;" onclick="document.getElementById('fileInputAdminVideo').click()">📁 رفع فيديو</button>
                </div>
            </div>

            <div>
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                    <h4 style="color: white; font-size:0.9rem;">📹 الحلقات المضافة</h4>
                    <button class="btn-del-single" style="background:var(--danger);" onclick="clearAllVideos()">🗑️️ مسح الكل</button>
                </div>

                <div id="adminVideosList" style="display:flex; flex-direction:column; gap:8px; max-height:180px; overflow-y:auto;"></div>
            </div>

            <div style="font-size:0.75rem; color:var(--text-dim); text-align:center; margin-top:10px;">
                جميع الحقوق محفوظة © <b>MRSTOUD TV</b>
            </div>
        </div>
    </div>

    <script>
        const ADMIN_PASS = "marwanhacker99";
        let storedVideos = [];
        let previousPage = 'homePage';

        // بيانات تجريبية أولية متوافقة
        const initialDemoData = [
            { id: 1, showName: "مسلسل أخي", episode: "22", poster: "https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=500", src: "", desc: "قصة مسلسل أخي والدراما الممتعة.", cast: "الممثلون المبدعون" },
            { id: 2, showName: "مسلسل حبك نار", episode: "4", poster: "https://images.unsplash.com/photo-1517604931442-7e0c8ed2963c?w=500", src: "", desc: "قصة حب مشوقة ومليئة بالأحداث.", cast: "أبطال المسلسل" },
            { id: 3, showName: "مسلسل نصف الأم", episode: "2", poster: "https://images.unsplash.com/photo-1574375927938-d5a98e8ffe85?w=500", src: "", desc: "قصة درامية عائلية.", cast: "طاقم العمل" }
        ];

        window.addEventListener('DOMContentLoaded', () => {
            const saved = localStorage.getItem('mrstoud_tv_shows_data');
            if (saved) {
                try { storedVideos = JSON.parse(saved); } 
                catch(e) { storedVideos = initialDemoData; }
            } else {
                storedVideos = initialDemoData;
            }
            renderAllViews();
        });

        function navigateTo(pageId) {
            const currentActive = document.querySelector('.page-view.active');
            if (currentActive && currentActive.id !== pageId && currentActive.id !== 'playerPage') {
                previousPage = currentActive.id;
            }

            document.querySelectorAll('.page-view').forEach(p => p.classList.remove('active'));
            document.getElementById(pageId).classList.add('active');

            if (pageId !== 'playerPage') {
                const player = document.getElementById('mainVideoPlayer');
                player.pause();
            }
        }

        function goBackFromPlayer() {
            navigateTo(previousPage || 'homePage');
        }

        function toggleSearchBox() {
            const box = document.getElementById('searchBoxContainer');
            box.style.display = box.style.display === 'block' ? 'none' : 'block';
            if(box.style.display === 'block') {
                document.getElementById('gallerySearch').focus();
            }
        }

        function saveData() {
            try {
                localStorage.setItem('mrstoud_tv_shows_data', JSON.stringify(storedVideos));
            } catch(e) { console.warn("تم الحفظ."); }
        }

        function renderAllViews() {
            renderHomePage();
            renderShowsListPage();
        }

        function renderHomePage() {
            const grid = document.getElementById('homeGrid');
            const countLabel = document.getElementById('homeCount');
            grid.innerHTML = '';
            countLabel.innerText = storedVideos.length + " حلقة متاحة";

            if (storedVideos.length === 0) {
                grid.innerHTML = `<div style="grid-column:1/-1; text-align:center; color:var(--text-dim); padding:40px;">لا توجد حلقات متاحة حالياً.</div>`;
                return;
            }

            storedVideos.forEach(vid => {
                grid.appendChild(createMediaCard(vid.showName + ` الحلقة ${vid.episode}`, vid.episode, vid.poster, () => openVideoPlayer(vid)));
            });
        }

        function renderShowsListPage() {
            const grid = document.getElementById('showsGrid');
            grid.innerHTML = '';

            const uniqueShows = {};
            storedVideos.forEach(v => {
                if (!uniqueShows[v.showName]) {
                    uniqueShows[v.showName] = v;
                }
            });

            const showNames = Object.keys(uniqueShows);
            if (showNames.length === 0) {
                grid.innerHTML = `<div style="grid-column:1/-1; text-align:center; color:var(--text-dim); padding:40px;">لا توجد مسلسلات حالياً.</div>`;
                return;
            }

            showNames.forEach(showName => {
                const item = uniqueShows[showName];
                grid.appendChild(createMediaCard(showName, null, item.poster, () => openShowDetailPage(showName)));
            });
        }

        function openShowDetailPage(showName) {
            const showEpisodes = storedVideos.filter(v => v.showName === showName);
            if (showEpisodes.length === 0) return;

            const mainInfo = showEpisodes[0];

            document.getElementById('showBannerTitle').innerText = showName;
            document.getElementById('showBannerDesc').innerText = mainInfo.desc || "لا يوجد وصف متاح لهذا المسلسل.";
            
            const castContainer = document.getElementById('showBannerCast');
            if (mainInfo.cast) {
                castContainer.innerHTML = `الممثلون : <span>${mainInfo.cast}</span>`;
            } else {
                castContainer.innerHTML = '';
            }

            document.getElementById('showBanner').style.backgroundImage = `url('${mainInfo.poster}')`;

            const epGrid = document.getElementById('showEpisodesGrid');
            epGrid.innerHTML = '';

            showEpisodes.forEach(vid => {
                epGrid.appendChild(createMediaCard(`${showName} الحلقة ${vid.episode}`, vid.episode, vid.poster, () => openVideoPlayer(vid)));
            });

            navigateTo('showDetailPage');
        }

        function createMediaCard(title, episodeNum, posterUrl, onClickHandler) {
            const card = document.createElement('div');
            card.className = 'media-card';
            card.onclick = onClickHandler;
            card.innerHTML = `
                <img src="${posterUrl}" class="media-poster-img" alt="${title}" onerror="this.src='https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=500'">
                ${episodeNum ? `
                <div class="episode-badge">
                    <span class="lbl">حلقة</span>
                    <span class="num">${episodeNum}</span>
                </div>` : ''}
                <div class="media-card-overlay">
                    <div class="media-card-title">${title}</div>
                </div>
            `;
            return card;
        }

        function openVideoPlayer(vid) {
            if (!vid.src) {
                alert('يرجى إضافة رابط أو ملف الفيديو الخاص بالحلقة من لوحة الإدارة أولاً لتتمكن من تشغيلها.');
                return;
            }
            document.getElementById('currentMediaTitle').innerText = `${vid.showName} - الحلقة ${vid.episode}`;
            const player = document.getElementById('mainVideoPlayer');
            const source = document.getElementById('videoSource');

            source.src = vid.src;
            player.load();
            navigateTo('playerPage');
        }

        function addVideoFromAdmin() {
            const showName = document.getElementById('adminShowName').value.trim();
            const ep = document.getElementById('adminEpisodeNum').value.trim();
            const url = document.getElementById('adminUrl').value.trim();
            const poster = document.getElementById('adminPosterUrl').value.trim();
            const desc = document.getElementById('adminShowDesc').value.trim();
            const cast = document.getElementById('adminShowCast').value.trim();

            if (!showName) return alert('يرجى كتابة اسم المسلسل!');

            storedVideos.unshift({
                id: Date.now() + Math.random(),
                showName: showName,
                episode: ep || '1',
                src: url,
                poster: poster || 'https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=500',
                desc: desc,
                cast: cast
            });

            document.getElementById('adminShowName').value = '';
            document.getElementById('adminEpisodeNum').value = '';
            document.getElementById('adminUrl').value = '';
            document.getElementById('adminPosterUrl').value = '';
            document.getElementById('adminShowDesc').value = '';
            document.getElementById('adminShowCast').value = '';

            saveData();
            alert('✅ تم إضافة الحلقة بنجاح!');
            renderAllViews();
            renderAdminVideosList();
        }

        document.getElementById('fileInputAdminVideo').addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file) {
                const showName = document.getElementById('adminShowName').value.trim() || "مسلسل جديد";
                const ep = document.getElementById('adminEpisodeNum').value.trim() || '1';
                const desc = document.getElementById('adminShowDesc').value.trim();
                const cast = document.getElementById('adminShowCast').value.trim();

                const reader = new FileReader();
                reader.onload = function(evt) {
                    storedVideos.unshift({
                        id: Date.now() + Math.random(),
                        showName: showName,
                        episode: ep,
                        src: evt.target.result,
                        poster: 'https://images.unsplash.com/photo-1517604931442-7e0c8ed2963c?w=500',
                        desc: desc,
                        cast: cast
                    });
                    saveData();
                    alert('✅ تم رفع فيديو الحلقة بنجاح!');
                    renderAllViews();
                    renderAdminVideosList();
                };
                reader.readAsDataURL(file);
            }
        });

        function deleteSingleVideo(id) {
            if (confirm('هل أنت متأكد من مسح هذه الحلقة؟')) {
                storedVideos = storedVideos.filter(v => v.id !== id);
                saveData();
                renderAllViews();
                renderAdminVideosList();
            }
        }

        function clearAllVideos() {
            if (confirm('هل أنت متأكد من مسح جميع الأعمال بالحامل؟')) {
                storedVideos = [];
                localStorage.removeItem('mrstoud_tv_shows_data');
                renderAllViews();
                renderAdminVideosList();
                alert('🗑 تم المسح الكامل.');
            }
        }

        function filterContent() {
            const query = document.getElementById('gallerySearch').value.toLowerCase();
            const cards = document.querySelectorAll('.page-view.active .media-card');
            cards.forEach(card => {
                const title = card.innerText.toLowerCase();
                card.style.display = title.includes(query) ? 'flex' : 'none';
            });
        }

        function openAdminPanel() {
            const pass = prompt("أدخل كود المرور السرية للإدارة:");
            if (pass === ADMIN_PASS) {
                document.getElementById('adminModal').style.display = 'flex';
                renderAdminVideosList();
            } else if (pass !== null) {
                alert("❌ كود خاطئ!");
            }
        }

        function closeAdminPanel() {
            document.getElementById('adminModal').style.display = 'none';
        }

        function renderAdminVideosList() {
            const container = document.getElementById('adminVideosList');
            container.innerHTML = '';
            if (storedVideos.length === 0) {
                container.innerHTML = '<span style="font-size:0.75rem; color:var(--text-dim);">لا توجد أعمال مسجلة</span>';
                return;
            }
            storedVideos.forEach(vid => {
                container.innerHTML += `
                    <div class="admin-video-item">
                        <span style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:260px;">🎬 ${vid.showName} - حلقة ${vid.episode}</span>
                        <button class="btn-del-single" onclick="deleteSingleVideo(${vid.id})">❌ مسح</button>
                    </div>
                `;
            });
        }

        function openSidebar() {
            document.getElementById('sidebar').classList.add('active');
            document.getElementById('sidebarOverlay').style.display = 'block';
        }

        function closeSidebar() {
            document.getElementById('sidebar').classList.remove('active');
            document.getElementById('sidebarOverlay').style.display = 'none';
        }

        function shareProject() {
            if (navigator.share) {
                navigator.share({ title: 'MRSTOUD TV', url: window.location.href });
            } else {
                alert('رابط الموقع: ' + window.location.href);
            }
        }
    </script>
</body>
</html>
